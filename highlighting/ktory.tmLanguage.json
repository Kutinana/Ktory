{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ktory",
  "scopeName": "source.ktory",
  "fileTypes": [
    "ktr",
    "ktory"
  ],
  "displayName": "Ktory",
  "patterns": [
    {
      "name": "comment.line.double-slash.ktory",
      "match": "//.*$"
    },
    {
      "include": "#raw-text"
    },
    {
      "name": "string.quoted.double.ktory",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "match": "\\\\."
        },
        {
          "include": "#raw-text"
        }
      ]
    },
    {
      "name": "string.quoted.single.ktory",
      "begin": "(?<![\\p{L}\\p{N}'\\\\])'(?!')",
      "end": "'(?!')|$",
      "patterns": [
        {
          "match": "\\\\."
        },
        {
          "include": "#raw-text"
        }
      ]
    },
    {
      "match": "^[ \\t]*((?i:@?defaultLang))([ \\t]*[:=])[ \\t]*([a-zA-Z0-9_-]+)",
      "captures": {
        "1": {
          "name": "variable.language.metadata.ktory"
        },
        "2": {
          "name": "punctuation.separator.key-value.ktory"
        },
        "3": {
          "name": "constant.other.locale.ktory"
        }
      }
    },
    {
      "begin": "^[ \\t]*(@speaker)(?:[ \\t]+([a-zA-Z0-9_-]+))?[ \\t]*([:：])",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.speaker.ktory"
        },
        "2": {
          "name": "entity.name.type.speaker.ktory"
        },
        "3": {
          "name": "punctuation.separator.key-value.ktory"
        }
      },
      "end": "$",
      "patterns": [
        {
          "name": "comment.line.double-slash.ktory",
          "match": "//.*$"
        },
        {
          "name": "string.quoted.double.ktory",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "string.quoted.single.ktory",
          "match": "(?<![\\p{L}\\p{N}])'(?:[^'\\\\]|\\\\.)*'"
        },
        {
          "match": "([a-zA-Z0-9_-]+)([ \\t]*[=:])",
          "captures": {
            "1": {
              "name": "constant.other.locale.ktory"
            },
            "2": {
              "name": "punctuation.separator.key-value.ktory"
            }
          }
        }
      ]
    },
    {
      "match": "^[ \\t]*(@[a-zA-Z0-9_-]+)([:：])",
      "captures": {
        "1": {
          "name": "constant.other.locale.ktory"
        },
        "2": {
          "name": "punctuation.separator.key-value.ktory"
        }
      }
    },
    {
      "name": "keyword.control.section.ktory",
      "match": "===.*?==="
    },
    {
      "name": "keyword.control.flow.ktory",
      "match": "(->|=>)"
    },
    {
      "comment": "Inline decorators start at a whitespace boundary and form a complete trailing sequence; prose dots remain text.",
      "begin": "(?<!\\S)(?=(?:[ \\t]*\\.[\\p{L}_][\\p{L}\\p{N}_]*(?:\\((?:[^)\"'\\\\]|\\\\.|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*')*\\))?)+[ \\t]*(?://.*)?$)",
      "end": "$",
      "patterns": [
        {
          "include": "#decorators"
        }
      ]
    },
    {
      "begin": "^[ \\t]*(#[a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.anchor.ktory"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#decorators"
        }
      ]
    },
    {
      "name": "string.quoted.choice.ktory",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.ktory"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ktory"
        }
      },
      "patterns": [
        {
          "include": "#raw-text"
        },
        {
          "match": "(@[a-zA-Z0-9_-]+)([ \\t]*[:：])",
          "captures": {
            "1": {
              "name": "constant.other.locale.ktory"
            },
            "2": {
              "name": "punctuation.separator.key-value.ktory"
            }
          }
        },
        {
          "name": "string.quoted.double.ktory",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "match": "\\\\."
            },
            {
              "include": "#raw-text"
            }
          ]
        },
        {
          "name": "string.quoted.single.ktory",
          "begin": "(?<![\\p{L}\\p{N}'\\\\])'(?!')",
          "end": "'(?!')|$",
          "patterns": [
            {
              "match": "\\\\."
            },
            {
              "include": "#raw-text"
            }
          ]
        }
      ]
    },
    {
      "name": "keyword.control.choice.ktory",
      "match": "^\\s*[*+]"
    },
    {
      "name": "entity.name.type.speaker.ktory",
      "match": "^[ \\t]*[^\\s:：@#.*+=>'\\[\\]-](?:(?!'{3})[^:：\\n])*(?=[:：])"
    }
  ],
  "repository": {
    "decorators": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ktory",
          "match": "//.*$"
        },
        {
          "name": "string.quoted.double.ktory",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "string.quoted.single.ktory",
          "match": "(?<![\\p{L}\\p{N}])'(?:[^'\\\\]|\\\\.)*'"
        },
        {
          "name": "entity.name.function.decorator.ktory",
          "match": "\\.[\\p{L}_][\\p{L}\\p{N}_]*"
        }
      ]
    },
    "raw-text": {
      "name": "string.quoted.raw.ktory",
      "begin": "(?<!')('{3,})(?!')",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.ktory"
        }
      },
      "end": "(?<!')\\1(?!')",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ktory"
        }
      }
    }
  }
}
