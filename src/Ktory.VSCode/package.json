{
  "name": "ktory",
  "displayName": "Ktory — Script & Preview",
  "description": "Ktory syntax highlighting and offline, in-editor reading powered by the shared C# core.",
  "version": "0.1.1",
  "publisher": "ktory",
  "icon": "icon.png",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kutinana/Ktory.git",
    "directory": "src/Ktory.VSCode"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ktory",
    "ktr",
    "narrative",
    "dialogue"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "ktory",
        "aliases": [
          "Ktory",
          "ktory"
        ],
        "extensions": [
          ".ktr",
          ".ktory"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ktory",
        "scopeName": "source.ktory",
        "path": "./syntaxes/ktory.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ktory.openPreview",
        "title": "Open Preview to the Side",
        "category": "Ktory",
        "icon": "$(open-preview)"
      },
      {
        "command": "ktory.reloadPreview",
        "title": "Reload Preview from Editor",
        "category": "Ktory",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ktory.openPreview",
          "when": "editorLangId == ktory",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ktory.openPreview",
          "when": "resourceExtname == .ktr || resourceExtname == .ktory",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "clean": "node scripts/clean.cjs",
    "package": "node scripts/package.cjs",
    "test": "node --test test/unit.test.cjs test/packaging.test.cjs",
    "test:integration": "node test/run-integration.cjs",
    "test:vsix": "node test/run-integration.cjs --vsix",
    "package:patch": "node scripts/package-patch.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  }
}
