{
  "name": "ktory",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "ktory",
  "icon": "icon.png",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kutinana/Ktory.git",
    "directory": "src/Ktory.VSCode"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "l10n": "./l10n",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ktory",
    "ktr",
    "narrative",
    "dialogue"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "ktory",
        "aliases": [
          "Ktory",
          "ktory"
        ],
        "extensions": [
          ".ktr",
          ".ktory"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ktory",
        "scopeName": "source.ktory",
        "path": "./syntaxes/ktory.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "ktory.preview.uiLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "zh-cn",
            "en",
            "ja"
          ],
          "enumItemLabels": [
            "%config.uiLanguage.auto%",
            "%config.uiLanguage.zhCn%",
            "%config.uiLanguage.en%",
            "%config.uiLanguage.ja%"
          ],
          "default": "auto",
          "description": "%config.uiLanguage.description%",
          "scope": "window"
        }
      }
    },
    "commands": [
      {
        "command": "ktory.openPreview",
        "title": "%command.openPreview%",
        "category": "Ktory",
        "icon": "$(open-preview)"
      },
      {
        "command": "ktory.reloadPreview",
        "title": "%command.reloadPreview%",
        "category": "Ktory",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ktory.openPreview",
          "when": "editorLangId == ktory",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "ktory.openPreview",
          "when": "resourceExtname == .ktr || resourceExtname == .ktory",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "clean": "node scripts/clean.cjs",
    "package": "node scripts/package.cjs",
    "test": "node --test test/unit.test.cjs test/packaging.test.cjs",
    "test:integration": "node test/run-integration.cjs",
    "test:vsix": "node test/run-integration.cjs --vsix",
    "package:patch": "node scripts/package-patch.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  }
}